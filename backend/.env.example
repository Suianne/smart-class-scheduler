# Copie para .env (nunca versione o .env) e preencha com os dados do seu projeto Supabase.
NODE_ENV=development
PORT=3000

# Supabase > Project Settings > Database > Connection string (use o Session pooler, porta 5432)
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-regiao.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=chave-anon-publica
# ATENCAO: chave administrativa. Somente no backend (Render). Jamais no frontend.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# URL(s) do frontend na Vercel, separadas por virgula
CORS_ORIGINS=https://seu-app.vercel.app,http://localhost:5173

# Senha das contas criadas por `npm run seed:auth` (somente desenvolvimento/demonstracao)
SEED_PASSWORD=TroqueEstaSenha#2026
