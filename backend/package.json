{
  "name": "sucelso-tech-backend",
  "version": "1.0.0",
  "description": "API REST do SUCELSO TECH (Node.js + Express + Supabase)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "db:reset": "node scripts/run-sql.js ../sql/00_reset.sql",
    "db:schema": "node scripts/run-sql.js ../sql/01_schema.sql ../sql/03_rls.sql",
    "db:seed": "node scripts/run-sql.js ../sql/02_seed.sql",
    "seed:auth": "node scripts/seed-auth.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "supertest": "^7.3.1"
  }
}
